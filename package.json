    "url": "git+https://github.com/ctenifaktur/cli.git"
  },
  "license": "MIT",
  "author": "Čtení Faktur s.r.o.",
  "type": "module",
  "bin": {
    "ctenifaktur": "dist/ctenifaktur.js"
  },
  "files": [
